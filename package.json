{
  "name": "excel-code-highlighter",
  "version": "1.0.0",
  "private": true,
  "description": "Excel add-in that syntax-highlights code in 31 languages inside worksheet cells.",
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/office-js": "^1.0.612",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-office-addins": "^5.0.1",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "eslint-plugin-office-addins": {
      "typescript": "$typescript"
    }
  }
}
